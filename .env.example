# Copy to .env for local docker-compose usage. Values here are safe
# placeholders for local development only -- never commit a real .env.

DATALAKE_DEBUG=true
DATALAKE_DJANGO_SECRET_KEY=dev-only-insecure-key
DATALAKE_ALLOWED_HOSTS=localhost,127.0.0.1

DATALAKE_POSTGRES_DB=datalake
DATALAKE_POSTGRES_USER=datalake
DATALAKE_POSTGRES_PASSWORD=datalake
DATALAKE_POSTGRES_HOST=postgres
DATALAKE_POSTGRES_PORT=5432

DATALAKE_RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672//

DATALAKE_MINIO_ENDPOINT=http://minio:9000
DATALAKE_MINIO_ACCESS_KEY=minioadmin
DATALAKE_MINIO_SECRET_KEY=minioadmin
DATALAKE_MINIO_BUCKET_RAW_PAYLOADS=datalake-raw-payloads
DATALAKE_MINIO_USE_SSL=false

# Generate your own: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
DATALAKE_SECRET_STORE_ENCRYPTION_KEY=B4Q8yYib3-h1P8m5S5r2G8f5s0d0f5g6h7j8k9l0m1o=

# Outbound HTTP security policy (apps.core.outbound_http). Empty by
# default -- no private/internal hosts are reachable until explicitly
# added here (deployment-wide) or per-tenant via AllowedOutboundHost.
# ALLOWED_PRIVATE_HOSTS (+ the per-tenant AllowedOutboundHost model) only
# ever bypasses the "private" (RFC1918/ULA) address category. ALLOWED_UNSAFE_HOSTS
# is the separate, deployment-only setting for the higher-risk categories
# (loopback/link-local/cloud-metadata/multicast/unspecified) -- leave it
# empty unless you specifically need it (e.g. a local sidecar in an
# isolated dev/CI environment). Neither allowlist implicitly permits
# plain http:// -- that's ALLOW_INSECURE_HTTP (deployment-wide) or
# INSECURE_ALLOWED_HOSTS (per-host) below.
DATALAKE_OUTBOUND_HTTP_ALLOWED_PRIVATE_HOSTS=
DATALAKE_OUTBOUND_HTTP_ALLOWED_UNSAFE_HOSTS=
DATALAKE_OUTBOUND_HTTP_ALLOW_INSECURE_HTTP=false
DATALAKE_OUTBOUND_HTTP_INSECURE_ALLOWED_HOSTS=
# Hard deployment ceilings: a connection's own config may set a lower
# response-size cap or timeout, never a higher one than these.
DATALAKE_OUTBOUND_HTTP_MAX_RESPONSE_BYTES=10485760
DATALAKE_OUTBOUND_HTTP_MAX_TIMEOUT_SECONDS=120
